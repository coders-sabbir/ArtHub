PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27018/arthub?replicaSet=arthub
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_SECRET=replace-with-another-random-secret-of-at-least-32-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Per-artwork publishing fee in USD. 0 publishes immediately; a positive fee
# (at least 0.50) requires verified Stripe payment before the artwork goes live.
PUBLISHING_FEE_USD=0
IMGBB_API_KEY=
# Demo seeding is explicit. Change these before using seed against production.
SEED_DEMO_DATA=false
SEED_ADMIN_PASSWORD=Admin@123
SEED_DEMO_PASSWORD=ArtHub@123
